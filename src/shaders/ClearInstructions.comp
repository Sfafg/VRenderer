#version 450

struct BatchMetaData {
    uint firstInstance;
    uint batchDataElementSize;
    uint materialIndex;
    uint meshIndex;
};

struct MeshMetaData {
    uint indexCount;
    uint firstIndex;
    uint vertexOffset;
};

struct DrawIndexed 
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    uint vertexOffset;
    uint firstInstance;
};

layout(push_constant) uniform PushConstants{
    uint batchCount;
};

layout(std430, binding = 0) readonly buffer BatchMetaDatas{
    BatchMetaData batchMetaData[];
};

layout(std430, binding = 1) readonly buffer MeshMetaDatas{
    MeshMetaData meshMetaData[];
};

layout(std430, binding = 2) buffer DrawInstructions{
    DrawIndexed drawInstructions[];
};

layout (local_size_x = 16, local_size_y = 1, local_size_z = 1) in;
void main()
{
	uint index = gl_GlobalInvocationID.x;
	if(index >= batchCount)
		return;
		
    BatchMetaData batch =batchMetaData[index];
    MeshMetaData mesh=meshMetaData[batch.meshIndex];

	drawInstructions[index].indexCount = mesh.indexCount;
	drawInstructions[index].instanceCount = 0;
	drawInstructions[index].firstIndex = mesh.firstIndex;
	drawInstructions[index].vertexOffset = mesh.vertexOffset;
	drawInstructions[index].firstInstance = batch.firstInstance;
}
