#version 450

struct InstanceMapping {
    uint objectDataIndex;
    uint batchIndex;
};

struct DrawCall 
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    uint vertexOffset;
    uint firstInstance;
    uint materialIndex ;
    uint meshIndex ;
    uint batchDataElementSize;
    uint lodCountPointerParent;
    uint firstObject;
};
const uint NULL_LOD = 0x0FFFFFFF;

layout(push_constant) uniform PushConstants{
    uint drawCount;
    uint objectCount;
};

// layout(std140, binding = 0) uniform CameraMatrices{
//     mat4 projection;
//     mat4 view;
//     mat4 viewProjection;
// };

layout(std430, binding = 2) buffer DrawCalls{
    DrawCall drawCalls[];
};

layout(std430, binding = 3) buffer InstanceMappings{
    InstanceMapping instanceMapping[];
};

// layout(std430, binding = 4) buffer BatchData{ float batchData[]; };

layout (local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;
void main() 
{
    uint sourceObjectIndex = gl_GlobalInvocationID.x;
    if(sourceObjectIndex >= objectCount) return;

    uint drawIndex=0;
    for(uint i = drawCount-1; i != -1U; i--)
    {
        if(drawCalls[i].lodCountPointerParent == NULL_LOD && sourceObjectIndex >= drawCalls[i].firstInstance){
            drawIndex = i;
            break;
        }
    }

    uint parent = drawIndex;
    uint lodCount = drawCalls[drawIndex].lodCountPointerParent>>28&0xF;

    if(lodCount!=0)
    {
        uint lodPointer = (drawCalls[drawIndex].lodCountPointerParent>>14)&0x03FFF;

        if(sourceObjectIndex%3==0) 
            drawIndex = lodPointer;
        else if(sourceObjectIndex%5==0)drawIndex=(drawCalls[lodPointer].lodCountPointerParent>>14)&0x03FFF; 
    }

    uint targetObjectIndex = atomicAdd(drawCalls[drawIndex].instanceCount,1) + drawCalls[drawIndex].firstInstance;
    instanceMapping[targetObjectIndex].objectDataIndex = sourceObjectIndex-drawCalls[parent].firstInstance;
    instanceMapping[targetObjectIndex].batchIndex = drawIndex;
}
