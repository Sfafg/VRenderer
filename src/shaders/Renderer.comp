#version 450

struct DrawCall 
{
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    uint vertexOffset;
    uint firstInstance;
    uint materialIndex ;
    uint meshIndex ;
    uint batchDataElementSize;
};

layout(push_constant) uniform PushConstants{
    uint drawCount;
    uint objectCount;
};

// layout(std140, binding = 0) uniform CameraMatrices{
//     mat4 projection;
//     mat4 view;
//     mat4 viewProjection;
// };

// MeshMetaDAt
layout(std430, binding = 2) buffer DrawCalls{
    DrawCall drawCalls[];
};

layout(std430, binding = 3) buffer InstanceMapping{
    uint instanceMapping[];
};

// layout(std430, binding = 4) buffer BatchData{ float batchData[]; };

layout (local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;
void main() 
{
    uint sourceObjectIndex = gl_GlobalInvocationID.x;
    if(sourceObjectIndex >= objectCount) return;

    uint drawID = 0;
    for(uint i = drawCount-1; i != -1U; i--)
        if(sourceObjectIndex >= drawCalls[i].firstInstance){
            drawID = i;
            break;
        }

    uint targetObjectIndex = atomicAdd(drawCalls[drawID].instanceCount,1) + drawCalls[drawID].firstInstance;
    instanceMapping[targetObjectIndex] = sourceObjectIndex;
}
