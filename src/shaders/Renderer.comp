#version 450

struct InstanceMapping {
    uint objectDataIndex;
    uint batchIndex;
};

#include "DrawCall.glsl"

layout(push_constant) uniform PushConstants {
    uint drawCount;
    uint objectCount;
};

layout(std140, binding = 0) uniform PassData {
    mat4 view;
    mat4 projection;
    mat4 viewProjection;
    vec3 cameraPosition;
};

layout(std430, binding = 2) buffer DrawCalls { DrawCall drawCalls[]; };

layout(std430, binding = 3) buffer InstanceMappings { InstanceMapping instanceMapping[]; };

layout(std430, binding = 4) buffer BatchDatas { float batchData[]; };

uint GetLodCount(uint drawCall) { return drawCalls[drawCall].lodCountPointerParent >> 28 & 0xF; }

uint GetLodIndex(uint drawCall) {
    uint id = drawCalls[drawCall].lodCountPointerParent >> 14 & 0x3FFF;
    if (id == 0x3FFF) return -1U;
    return id;
}
uint GetParentIndex(uint drawCall) {
    uint id = drawCalls[drawCall].lodCountPointerParent & 0x3FFF;
    if (id == 0x3FFF) return -1U;
    return id;
}

uint GetDrawCallIndex(uint sourceObjectIndex, out uint objectID) {
    uint runningSum = 0;
    uint i = 0;
    for (; i < drawCount; i++) {
        runningSum += drawCalls[i].objectCount;
        if (sourceObjectIndex < runningSum) break;
    }
    objectID = sourceObjectIndex - (runningSum - drawCalls[i].objectCount);
    return i;
}

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint sourceObjectIndex = gl_GlobalInvocationID.x;
    if (sourceObjectIndex >= objectCount) return;

    uint objectID;
    uint baseDrawCall = GetDrawCallIndex(sourceObjectIndex, objectID);
    uint drawCall = baseDrawCall;
    uint lodCount = GetLodCount(baseDrawCall);
    if (lodCount != 0) {
        uint dataIndex =
            (drawCalls[baseDrawCall].firstObject + objectID) * drawCalls[baseDrawCall].objectDataElementSize / 4;
        vec3 objectPosition = vec3(batchData[dataIndex + 12], batchData[dataIndex + 13], batchData[dataIndex + 14]);
        float d = distance(objectPosition, cameraPosition) / 100;
        uint lodIndex = min(lodCount, uint(d * lodCount));
        for (int i = 0; i < lodIndex; i++) drawCall = GetLodIndex(drawCall);
    }

    uint targetObjectIndex = atomicAdd(drawCalls[drawCall].instanceCount, 1) + drawCalls[drawCall].firstInstance;
    instanceMapping[targetObjectIndex].objectDataIndex = objectID;
    instanceMapping[targetObjectIndex].batchIndex = drawCall;
}
