#version 450
#include "DrawCall.glsl"

// OPTYMIZATION: Might compress it a bit, to remove padding.
struct MeshMetaData {
    vec3 boundsMin;
    float padding1;

    vec3 boundsMax;
    float padding2;

    uint indexCount;
    uint firstIndex;
    uint vertexOffset;
    float padding3;
};

layout(push_constant) uniform PushConstants {
    mat4 cameraViewProjection;

    uint batchCount;
    uint objectCount;
    uint firstTransparentDrawCall;
    uint transparentDrawCallCount;

    vec3 cameraPosition;
    uint bucketCount;

    float nearPlane;
    float farPlane;
    float padding2;
    float padding3;
};

layout(binding = 0) uniform sampler2D hiZBuffer;
layout(std430, binding = 1) readonly buffer BatchInfos { BatchInfo batchInfo[]; };
layout(std430, binding = 2) buffer DrawCalls { DrawCall drawCalls[]; };
layout(std430, binding = 3) buffer InstanceMappings { uint instanceMapping[]; };
layout(std430, binding = 4) buffer BatchDatas { float batchData[]; };
layout(std430, binding = 5) readonly buffer MeshMetaDatas { MeshMetaData meshMetaData[]; };

BatchInfo GetBatch(uint sourceObjectIndex) {
    uint l = 0;
    uint r = batchCount - 1;
    while (l <= r) {
        uint m = (r + l) / 2;
        if (sourceObjectIndex > batchInfo[m].firstObjectIndex) l = m + 1;
        else if (sourceObjectIndex < batchInfo[m].firstObjectIndex) r = m - 1;
        else return batchInfo[m];
    }
    return batchInfo[r];

    // Linear search.
    for (int i = 1; i < batchCount; i++)
        if (batchInfo[i].firstObjectIndex > sourceObjectIndex) return batchInfo[i - 1];

    return batchInfo[batchCount - 1];
}

mat4 GetObjectMatrix(BatchInfo batch, uint objectID) {
    uint dataIndex = (objectID - batch.firstObjectIndex + batch.objectDataOffset) * batch.objectDataElementSize / 4;

    return mat4(
        batchData[dataIndex + 0], batchData[dataIndex + 1], batchData[dataIndex + 2], batchData[dataIndex + 3],
        batchData[dataIndex + 4], batchData[dataIndex + 5], batchData[dataIndex + 6], batchData[dataIndex + 7],
        batchData[dataIndex + 8], batchData[dataIndex + 9], batchData[dataIndex + 10], batchData[dataIndex + 11],
        batchData[dataIndex + 12], batchData[dataIndex + 13], batchData[dataIndex + 14], batchData[dataIndex + 15]
    );
}

float GetBoundingBoxInNDC(BatchInfo batch, uint objectID, out vec3 minPoint, out vec3 maxPoint) {
    mat4 model = GetObjectMatrix(batch, objectID);
    mat4 localToNDC = cameraViewProjection * model;

    MeshMetaData metaData = meshMetaData[drawCalls[batch.drawCall].meshIndex];
    vec3 bMin = metaData.boundsMin;
    vec3 bMax = metaData.boundsMax;

    minPoint = vec3(1e30);
    maxPoint = vec3(-1e30);

    for (int i = 0; i < 8; i++) {
        vec4 p =
            vec4((i & 1) != 0 ? bMax.x : bMin.x, (i & 2) != 0 ? bMax.y : bMin.y, (i & 4) != 0 ? bMax.z : bMin.z, 1);
        p = localToNDC * p;
        if (p.w > 0) p /= p.w;
        else continue;

        minPoint = min(minPoint, p.xyz);
        maxPoint = max(maxPoint, p.xyz);
    }

    return (2.0 * nearPlane * farPlane) / (farPlane + nearPlane - minPoint.z * (farPlane - nearPlane)) / farPlane;
}

float GetCameraDistance(BatchInfo batch, uint objectID, vec3 cameraPosition) {
    uint dataIndex = (objectID - batch.firstObjectIndex + batch.objectDataOffset) * batch.objectDataElementSize / 4;
    vec3 objectPosition = vec3(batchData[dataIndex + 12], batchData[dataIndex + 13], batchData[dataIndex + 14]);
    return distance(objectPosition, cameraPosition);
}

layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;
void main() {
    uint objectID = gl_GlobalInvocationID.x;
    if (objectID >= objectCount) return;

    BatchInfo batch = GetBatch(objectID);
    uint drawCall = batch.drawCall;

    // Lod selection.
    if (batch.lods[0] != -1U) {
        uint lodCount = 1 + uint(batch.lods[1] != -1U) + uint(batch.lods[2] != -1U) + uint(batch.lods[3] != -1U);
        // TODO: Add dedicated buffer for transformation matrices and remove object data element size.
        uint lodIndex = min(lodCount, uint(GetCameraDistance(batch, objectID, cameraPosition) / 100 * lodCount));
        drawCall = batch.lods[lodIndex];
    }

    // Visibility check.
    vec3 minPoint, maxPoint;
    float cameraDistane01 = GetBoundingBoxInNDC(batch, objectID, minPoint, maxPoint);

    bool isVisible = true;
    if (any(greaterThan(minPoint, vec3(1))) || any(lessThan(maxPoint, vec3(-1)))) isVisible = false;

    vec4 aabb = vec4(minPoint.x, minPoint.y, maxPoint.x, maxPoint.y) * 0.5 + 0.5;
    float objectScreenWidth = (aabb.z - aabb.x) * 1920;
    float objectScreenHeight = (aabb.w - aabb.y) * 1080;
    float mipLevel = floor(log2(max(objectScreenWidth, objectScreenHeight)));

    float hiZDepth = textureLod(hiZBuffer, (aabb.xy + aabb.zw) * 0.5, mipLevel * 1).x;
    if (minPoint.z > hiZDepth) isVisible = false;

    if (!isVisible) return;

    // Transparency sorting.
    if (drawCall >= firstTransparentDrawCall) {
        float d = pow(cameraDistane01, 1);
        uint bucketID = min(uint(d * bucketCount), bucketCount - 1);
        bucketID = bucketCount - 1 - bucketID;
        drawCall += bucketID * transparentDrawCallCount;
    }

    uint mappingID = atomicAdd(drawCalls[drawCall].instanceCount, 1) + drawCalls[drawCall].firstInstance;
    instanceMapping[mappingID] = objectID - batch.firstObjectIndex + batch.objectDataOffset;
}
